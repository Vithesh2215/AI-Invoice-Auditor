# =============================================================================
# AI Invoice Auditor - the only configuration file.
#
# Compose loads ./.env automatically and compose.yaml hands each container just
# the variables that service is entitled to, so a single file to edit does not
# mean the superuser password ends up in the dashboard container.
#
# Every credential is declared once. The init script that creates a role and
# the service that logs in with it read the same variable, so they cannot drift.
#
# Copy to .env and fill in the blanks:  cp .env.example .env
# =============================================================================

# --- host identity -----------------------------------------------------------
# The agent writes reports into a bind mount, so it must run as the host user
# that owns data/incoming and data/reports. Use `id -u` and `id -g`.
AGENT_UID=1000
AGENT_GID=1000

# --- database ----------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
POSTGRES_DB=invoice_auditor

# Superuser. Used only by the entrypoint and the init scripts.
POSTGRES_USER=invoice_admin
POSTGRES_PASSWORD=

# ERP reader, created by 02_reader.sh: SELECT on the erp schema and nothing
# else. Consumed by the mock-erp service.
ERP_DB_USER=erp_reader
ERP_DB_PASSWORD=

# Agent role, created by 04_app_roles.sh: read/write on audit, owner of
# langgraph, no privileges whatsoever on erp.
AGENT_DB_USER=invoice_agent
AGENT_DB_PASSWORD=

# Dashboard role, created by 04_app_roles.sh: SELECT on audit only,
# default_transaction_read_only, nothing on erp or langgraph.
UI_DB_USER=invoice_ui
UI_DB_PASSWORD=

# --- AWS Bedrock via LiteLLM -------------------------------------------------
# Without credentials the pipeline still runs: translation, severity grading
# and report prose degrade and invoices route to manual review.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

LLM_ENABLED=true
LLM_REASONING_MODEL=bedrock/amazon.nova-lite-v1:0
LLM_TRANSLATION_MODEL=bedrock/amazon.nova-lite-v1:0
LLM_RAG_MODEL=bedrock/amazon.nova-lite-v1:0
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3

# --- embeddings --------------------------------------------------------------
# fastembed runs a 384-dimension ONNX model on CPU inside the container and is
# the default because this account has InvokeModel denied on every Bedrock
# embedding model. Switching to bedrock changes the vector dimension, which the
# agent detects against the existing Qdrant collection at startup and refuses.
EMBEDDING_PROVIDER=bedrock
EMBEDDING_MODEL=amazon.titan-embed-text-v1
QDRANT_COLLECTION=invoice_chunks

# --- agent runtime -----------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
ERP_TIMEOUT_SECONDS=10

WATCH_ENABLED=true
WATCH_INTERVAL_SECONDS=10
WATCH_STABILITY_SECONDS=2
WATCH_MAX_CONCURRENCY=2

OCR_LANGUAGES=eng+spa+deu
OCR_DPI=300
OCR_MIN_TEXT_CHARS=40

# --- dashboard ---------------------------------------------------------------
AGENT_API_TIMEOUT=180
